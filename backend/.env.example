DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/meals_rmg?schema=public"
PORT=3000
JWT_SECRET=
JWT_REFRESH_SECRET=
REDIS_URL=

# When the API is exposed under a path prefix (e.g. nginx https://host/meals-rmg/ → Nest),
# set the same prefix so Socket.IO uses /meals-rmg/socket.io instead of /socket.io at domain root.
# Leave unset for local dev (direct http://localhost:3000).
# MEALS_PUBLIC_PATH=/meals-rmg

# DISABLE_TIME_LOCK=true
