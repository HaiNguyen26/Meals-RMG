DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/meals_rmg?schema=public"
PORT=3000
JWT_SECRET=
JWT_REFRESH_SECRET=
REDIS_URL=

# Optional: path to Vite dist when it is not ../frontend/dist from the repo root (SPA served by Nest).
# FRONTEND_DIST_PATH=/var/www/meals-rmg/frontend/dist

# Public URL prefix for the app (Vite base /meals-rmg/). REST API is /meals-rmg/api; Socket.IO path is /meals-rmg/socket.io.
# Leave unset for local dev at http://localhost:3000 (defaults to /meals-rmg when path-prefixed).
# MEALS_PUBLIC_PATH=/meals-rmg

# DISABLE_TIME_LOCK=true
